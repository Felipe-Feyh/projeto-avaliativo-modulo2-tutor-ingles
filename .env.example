# === LLM providers ===
# Provedor primário (Groq) e fallback (Google Gemini). Nunca versione valores reais.

# Groq (primário) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (fallback) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Provider ativo: groq | gemini (o fallback é acionado automaticamente em falha)
LLM_PROVIDER=groq

# === App ===
LOG_LEVEL=INFO
# Caminho do banco SQLite de memória/persistência
MENTORIA_DB_PATH=data/mentoria.db

# === API / integrações low-code (opcionais) ===
# Se definido, a API exige o header X-API-Key com este valor.
MENTORIA_API_KEY=
# Webhook do Discord para ChatOps (alertas/relatórios). Nunca versione o valor real.
DISCORD_WEBHOOK_URL=
